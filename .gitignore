# --- Local configuration and secrets ---
.env
.env.*
!.env.example
*.local.yml
*.local.yaml
application-local.yml
application-local.yaml
src/main/resources/application-secrets.*

# --- Runtime data (containers, volumes) ---
/data/
/infrastructure/data/
/infrastructure/**/volumes/

# --- Corpus: only the manifest and attribution are versioned ---
/corpus/documents/
!/corpus/MANIFEST.yml
!/corpus/ATTRIBUTION.md

# --- Evaluation: datasets are versioned, raw runs are not ---
/eval/runs/
/eval/.cache/

# --- Logs ---
*.log
logs/


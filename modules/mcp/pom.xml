<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.fragudev.ailab</groupId>
    <artifactId>ai-engineering-lab</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>mcp</artifactId>
  <packaging>jar</packaging>

  <name>AI Engineering Lab :: mcp</name>
  <description>MCP server exposing the tool registry; MCP client for external tool servers.</description>

  <dependencies>
    <dependency>
      <groupId>io.github.fragudev.ailab</groupId>
      <artifactId>shared</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.fragudev.ailab</groupId>
      <artifactId>tools</artifactId>
    </dependency>
    <!-- Not "AI integration" in the ai-provider sense (no ChatModel/EmbeddingModel access) — MCP
         protocol support, explicitly carved out of the "Spring AI only inside ai-provider" locked
         decision for this reason. See AGENTS.md and docs/adr/0011-mcp-tool-exposure-boundaries.md.
         No explicit <version> needed: resolved via the root pom.xml's spring-ai-bom import. -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-starter-mcp-client</artifactId>
    </dependency>
    <!-- jakarta.validation-api + Hibernate Validator, for @Validated on McpProperties
         (post-roadmap review B3) — an explicit direct edge rather than relying on the incidental
         transitive one via `tools`. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- ApplicationContextRunner, for testing @ConfigurationProperties validation without booting
         the full app context (post-roadmap review B3). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>

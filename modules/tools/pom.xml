<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.fragudev.ailab</groupId>
    <artifactId>ai-engineering-lab</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>tools</artifactId>
  <packaging>jar</packaging>

  <name>AI Engineering Lab :: tools</name>
  <description>Tool registry, JSON Schema validation, authorization and sandboxed execution.</description>

  <dependencies>
    <dependency>
      <groupId>io.github.fragudev.ailab</groupId>
      <artifactId>shared</artifactId>
    </dependency>
    <!-- ADR-0004's own Consequences section already commits, in writing, to "the tools module
         depends on ProviderCapabilities for its structured-output fallback" — docs/architecture.md
         #3's table said `shared` only, which was a real, uncorrected contradiction until ADR-0009
         (Phase 5) added this edge for real. -->
    <dependency>
      <groupId>io.github.fragudev.ailab</groupId>
      <artifactId>ai-provider</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <!-- Version pinned explicitly (no BOM covers it) — verified against the project's real GitHub
         releases during Phase 5 planning, not the Maven Central search index, which under-reports
         and still surfaces an old 1.x line as "latest". The 3.x line targets Jackson 3, matching
         Spring Boot 4.1's default HTTP message conversion. -->
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <version>3.0.6</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.fragudev.ailab</groupId>
    <artifactId>ai-engineering-lab</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>workflow</artifactId>
  <packaging>jar</packaging>

  <name>AI Engineering Lab :: workflow</name>
  <description>Agentic workflow state machine, run persistence and compensation.</description>

  <dependencies>
    <dependency>
      <groupId>io.github.fragudev.ailab</groupId>
      <artifactId>shared</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.fragudev.ailab</groupId>
      <artifactId>ai-provider</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.fragudev.ailab</groupId>
      <artifactId>rag</artifactId>
    </dependency>
    <!-- Real edge, found during Phase 6 implementation, not just an incidental transitive jar:
         RagPipeline.search's own return type (RetrievalTrace) carries knowledge.SearchResult/Chunk
         directly, and the retrieve stage genuinely reads them (chunk id/document id/content) to
         deduplicate and cap sources before extraction. docs/architecture.md #3's table didn't list
         this edge; corrected in docs/adr/0010-agent-orchestration.md, the same kind of correction
         ADR-0009 made for tools -> ai-provider in Phase 5. -->
    <dependency>
      <groupId>io.github.fragudev.ailab</groupId>
      <artifactId>knowledge</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.fragudev.ailab</groupId>
      <artifactId>tools</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <!-- jakarta.validation-api + Hibernate Validator, for @Validated on WorkflowsProperties
         (post-roadmap review B3) — an explicit direct edge rather than relying on the incidental
         transitive one via `tools`. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- ApplicationContextRunner, for testing @ConfigurationProperties validation without booting
         the full app context (post-roadmap review B3). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>

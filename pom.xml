<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>io.github.fragudev.ailab</groupId>
  <artifactId>ai-engineering-lab</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>AI Engineering Lab</name>
  <description>Production-grade reference application for AI engineering on the JVM.</description>
  <url>https://github.com/Fragudev/ai-engineering-lab</url>

  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <properties>
    <java.version>25</java.version>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <spring-ai.version>2.0.0</spring-ai.version>
    <spring-modulith.version>2.1.1</spring-modulith.version>
    <archunit.version>1.5.0</archunit.version>
    <jspecify.version>1.0.1</jspecify.version>
    <testcontainers.version>2.0.5</testcontainers.version>

    <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
    <spotless-maven-plugin.version>3.10.0</spotless-maven-plugin.version>
    <cyclonedx-maven-plugin.version>2.9.3</cyclonedx-maven-plugin.version>
    <dependency-check-maven.version>13.0.0</dependency-check-maven.version>
    <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
    <postgresql.version>42.7.13</postgresql.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.ai</groupId>
        <artifactId>spring-ai-bom</artifactId>
        <version>${spring-ai.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Overrides spring-boot-starter-parent's managed 42.7.11: found by this phase's own live
           Trivy scan (CVE-2026-54291, a SCRAM channel-binding downgrade, fixed in 42.7.12) — the one
           finding from that scan actually within this project's control, as opposed to base-image OS
           packages this project doesn't build (docs/threat-model.md Supply chain). -->
      <dependency>
        <groupId>org.postgresql</groupId>
        <artifactId>postgresql</artifactId>
        <version>${postgresql.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework.modulith</groupId>
        <artifactId>spring-modulith-bom</artifactId>
        <version>${spring-modulith.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- Internal modules -->
      <dependency>
        <groupId>io.github.fragudev.ailab</groupId>
        <artifactId>shared</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.fragudev.ailab</groupId>
        <artifactId>ai-provider</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.fragudev.ailab</groupId>
        <artifactId>conversation</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.fragudev.ailab</groupId>
        <artifactId>knowledge</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.fragudev.ailab</groupId>
        <artifactId>ingestion</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.fragudev.ailab</groupId>
        <artifactId>rag</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.fragudev.ailab</groupId>
        <artifactId>tools</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.fragudev.ailab</groupId>
        <artifactId>workflow</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.fragudev.ailab</groupId>
        <artifactId>mcp</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.fragudev.ailab</groupId>
        <artifactId>evaluation</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.fragudev.ailab</groupId>
        <artifactId>platform</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
      <version>${jspecify.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven-compiler-plugin.version}</version>
        <configuration>
          <release>${maven.compiler.release}</release>
          <encoding>${project.build.sourceEncoding}</encoding>
          <parameters>true</parameters>
        </configuration>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless-maven-plugin.version}</version>
        <configuration>
          <java>
            <palantirJavaFormat/>
            <removeUnusedImports/>
            <importOrder/>
            <trimTrailingWhitespace/>
            <endWithNewline/>
          </java>
        </configuration>
        <executions>
          <execution>
            <id>spotless-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Instruments every module's own test JVM (prepare-agent, default binding: initialize) and
           writes that module's own HTML/XML report (report, default binding: verify) — both left at
           their intrinsic default phase, no override needed. The reactor-wide number this measures
           (post-roadmap review issue #33) comes from app/pom.xml's separate report-aggregate
           execution: app is the one module that already depends on all eleven others, so it's the
           natural aggregation point without inventing a synthetic dependency just for coverage. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco-maven-plugin.version}</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Not bound to the default lifecycle — invoked explicitly (release.yml: makeAggregateBom;
           CI's security job: dependency-check:check), so `./mvnw verify` stays fast for local dev.
           cyclonedx-maven-plugin binds makeAggregateBom to the `package` phase on its own even with
           no <executions> declared here — confirmed by a real `./mvnw verify` run producing a
           `*-cyclonedx.json` in every module's target/ unprompted. The empty-phase override below is
           the standard Maven technique to cancel a plugin's own intrinsic default binding. -->
      <plugin>
        <groupId>org.cyclonedx</groupId>
        <artifactId>cyclonedx-maven-plugin</artifactId>
        <version>${cyclonedx-maven-plugin.version}</version>
        <executions>
          <execution>
            <id>default</id>
            <phase>none</phase>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.owasp</groupId>
        <artifactId>dependency-check-maven</artifactId>
        <version>${dependency-check-maven.version}</version>
        <configuration>
          <format>SARIF</format>
          <failBuildOnCVSS>9</failBuildOnCVSS>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <modules>
    <module>modules/shared</module>
    <module>modules/ai-provider</module>
    <module>modules/conversation</module>
    <module>modules/knowledge</module>
    <module>modules/ingestion</module>
    <module>modules/rag</module>
    <module>modules/tools</module>
    <module>modules/workflow</module>
    <module>modules/mcp</module>
    <module>modules/evaluation</module>
    <module>modules/platform</module>
    <module>app</module>
  </modules>
</project>

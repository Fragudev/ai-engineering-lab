<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.fragudev.ailab</groupId>
    <artifactId>ai-engineering-lab</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>app</artifactId>
  <packaging>jar</packaging>

  <name>AI Engineering Lab :: app</name>
  <description>
    The single deployable Spring Boot application. Wires every domain module together; owns no
    domain logic of its own (see docs/architecture.md #3).
  </description>

  <dependencies>
    <!-- Domain modules -->
    <dependency>
      <groupId>io.github.fragudev.ailab</groupId>
      <artifactId>shared</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.fragudev.ailab</groupId>
      <artifactId>ai-provider</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.fragudev.ailab</groupId>
      <artifactId>conversation</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.fragudev.ailab</groupId>
      <artifactId>knowledge</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.fragudev.ailab</groupId>
      <artifactId>ingestion</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.fragudev.ailab</groupId>
      <artifactId>rag</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.fragudev.ailab</groupId>
      <artifactId>tools</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.fragudev.ailab</groupId>
      <artifactId>workflow</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.fragudev.ailab</groupId>
      <artifactId>mcp</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.fragudev.ailab</groupId>
      <artifactId>evaluation</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.fragudev.ailab</groupId>
      <artifactId>platform</artifactId>
    </dependency>

    <!-- Web + health -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-opentelemetry</artifactId>
    </dependency>
    <!-- Live spec at /v3/api-docs, checked by eye against the checked-in openapi.yaml for now; an
         automated contract diff is a follow-up, not built this phase. -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>3.1.0</version>
    </dependency>

    <!-- Persistence -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <!--
      Spring Boot 4 splits auto-configuration out of the monolithic spring-boot-autoconfigure jar
      into per-technology modules; flyway-core/flyway-database-postgresql alone are inert without
      this starter, which pulls in the spring-boot-flyway auto-configuration module.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Module boundaries -->
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-starter-core</artifactId>
    </dependency>
    <!-- Transactional outbox for Kafka externalization (docs/adr/0005-kafka.md) -->
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-events-jpa</artifactId>
    </dependency>
    <!-- Jackson-based EventSerializer, required by spring-modulith-events-jpa's publication
         registry to (de)serialize outbox rows; not pulled in transitively by events-jpa itself. -->
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-events-jackson</artifactId>
    </dependency>

    <!-- Test -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-resttestclient</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-kafka</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>ai-engineering-lab</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <!-- DemoJourneyEndToEndTest (post-roadmap review issue #34) is tagged "e2e" and excluded from
           the normal ./mvnw verify run by default here — it chains real Postgres + Kafka + a real
           MCP handshake into one continuous flow, materially slower than this project's other
           container-backed integration tests, which each exercise one capability in isolation. The
           `e2e` profile below flips this to run ONLY that tag, for its own dedicated CI job. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludedGroups>e2e</excludedGroups>
        </configuration>
      </plugin>
      <!-- The reactor-wide coverage number (post-roadmap review issue #33): app is the only module
           that already depends on all eleven others, so it's the natural place to merge every
           module's jacoco.exec into one report rather than adding a synthetic dependency elsewhere
           just for this. report-aggregate needs an explicit phase (unlike prepare-agent/report
           inherited from the root pom, it has no intrinsic default binding — confirmed live: without
           this it silently never ran). check is a separate goal with its own real scope limitation —
           see its own execution's comment below for what it actually enforces and why (measured for
           real, not guessed — AGENTS.md rule 2). -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>report-aggregate</id>
            <phase>verify</phase>
            <goals>
              <goal>report-aggregate</goal>
            </goals>
          </execution>
          <!-- check's own real, verified-live limitation (not documented anywhere obvious in
               JaCoCo's own docs): unlike report-aggregate, it doesn't walk the reactor to analyze
               sibling modules' bytecode — it only ever checks the CURRENT project's own compiled
               classes against its own (or an explicitly merged) exec data. Binding it here therefore
               enforces a floor on app's own module bundle specifically, not the reactor-wide figure
               report-aggregate produces and docs/architecture.md §11 documents (88.0%). Confirmed by
               running it: app's own bundle measured 1619/2025 instructions = 79.95% — well below the
               reactor aggregate, since most non-app modules' code only gets exercised later, during
               app's own integration tests, which this module's own jacoco.exec never sees. Threshold
               set at 75%, a real margin below the 79.95% actually measured for this specific bundle
               (not the 88.0% headline figure — using that here would silently pass even if app's own
               module's tests regressed badly, as long as the rest of the reactor stayed covered). -->
          <execution>
            <id>check</id>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>INSTRUCTION</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.75</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Activated explicitly (-Pe2e) by ci.yml's dedicated e2e job, and available locally the same
         way: ./mvnw test -pl app -am -Pe2e. Inverts the default plugin config above — this profile's
         plugin block, not a full replacement, so everything else (jacoco, spring-boot-maven-plugin)
         stays exactly as configured in <build> above. -->
    <profile>
      <id>e2e</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration combine.self="override">
              <groups>e2e</groups>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>

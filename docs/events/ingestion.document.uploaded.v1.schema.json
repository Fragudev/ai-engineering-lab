{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-engineering-lab/events/ingestion.document.uploaded.v1.schema.json",
  "title": "ingestion.document.uploaded.v1",
  "type": "object",
  "required": [
    "eventId", "type", "source", "subject", "time", "correlationId", "causationId",
    "documentId", "title", "mimeType", "contentHash", "contentBase64"
  ],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "type": { "const": "ingestion.document.uploaded.v1" },
    "source": { "type": "string" },
    "subject": { "type": "string" },
    "time": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string", "format": "uuid" },
    "causationId": { "type": "string", "format": "uuid" },
    "documentId": { "type": "string", "format": "uuid" },
    "title": { "type": "string" },
    "mimeType": { "type": "string" },
    "contentHash": { "type": "string", "description": "SHA-256, hex-encoded." },
    "contentBase64": {
      "type": "string",
      "contentEncoding": "base64",
      "description": "Original bytes. Deferred: a real object store for source_uri; see docs/roadmap.md Phase 2 scope notes."
    }
  },
  "additionalProperties": false
}

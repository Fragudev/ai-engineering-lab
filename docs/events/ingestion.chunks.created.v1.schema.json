{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-engineering-lab/events/ingestion.chunks.created.v1.schema.json",
  "title": "ingestion.chunks.created.v1",
  "type": "object",
  "required": [
    "eventId", "type", "source", "subject", "time", "correlationId", "causationId",
    "documentId", "chunks"
  ],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "type": { "const": "ingestion.chunks.created.v1" },
    "source": { "type": "string" },
    "subject": { "type": "string" },
    "time": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string", "format": "uuid" },
    "causationId": { "type": "string", "format": "uuid" },
    "documentId": { "type": "string", "format": "uuid" },
    "chunks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ordinal", "content"],
        "properties": {
          "ordinal": { "type": "integer", "minimum": 0 },
          "content": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
